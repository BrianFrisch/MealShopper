{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mealshopper.com/schemas/top-deals.schema.json",
  "title": "TopDealsPayload",
  "description": "Schema definition for top evaluated deals in a regional context",
  "type": "object",
  "required": [
    "timestamp",
    "region_context",
    "deals"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp representing when the top deals payload was generated"
    },
    "region_context": {
      "type": "object",
      "description": "Geographical and store scope context for the deals",
      "required": [
        "coordinates",
        "store_ids"
      ],
      "properties": {
        "coordinates": {
          "type": "object",
          "description": "Geographic coordinates for the regional center or user location",
          "required": [
            "latitude",
            "longitude"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "description": "Latitude in decimal degrees"
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "description": "Longitude in decimal degrees"
            }
          },
          "additionalProperties": false
        },
        "store_ids": {
          "type": "array",
          "description": "List of store identifiers included in this regional scope",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "deals": {
      "type": "array",
      "description": "List of top evaluated deals",
      "items": {
        "type": "object",
        "required": [
          "deal_id",
          "store_id",
          "store_name",
          "item_name",
          "normalized_category",
          "deal_price",
          "unit",
          "value_score"
        ],
        "properties": {
          "deal_id": {
            "type": "string",
            "description": "Unique identifier for the deal"
          },
          "store_id": {
            "type": "string",
            "description": "Identifier of the store offering this deal"
          },
          "store_name": {
            "type": "string",
            "description": "Display name of the grocery store"
          },
          "item_name": {
            "type": "string",
            "description": "Descriptive name of the food item or product"
          },
          "normalized_category": {
            "type": "string",
            "enum": [
              "Produce",
              "Dairy",
              "Meat",
              "Seafood",
              "Pantry",
              "Bakery"
            ],
            "description": "Standardized product category"
          },
          "deal_price": {
            "type": "number",
            "minimum": 0,
            "description": "Current promotional deal price"
          },
          "original_price": {
            "type": "number",
            "minimum": 0,
            "description": "Original non-discounted price if available"
          },
          "currency": {
            "type": "string",
            "default": "USD",
            "pattern": "^[A-Z]{3}$",
            "description": "Three-letter ISO 4217 currency code"
          },
          "unit": {
            "type": "string",
            "description": "Measurement unit for the price (e.g., lb, oz, count, each)"
          },
          "value_score": {
            "type": "number",
            "minimum": 1,
            "maximum": 10,
            "description": "Evaluated value score on a scale of 1 to 10"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}